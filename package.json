{
  "name": "code-to-play",
  "displayName": "Code to Play",
  "description": "Play games in VS Code - earn playtime by writing code!",
  "version": "0.0.1",
  "publisher": "morse-code",
  "main": "./dist/extension.js",
  "author": {
    "name": "Victor Okenwa",
    "email": "okenwavictor003@gmail.com"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeToPlay",
          "title": "Code to Play",
          "icon": "media/icons/game-controller.svg"
        }
      ]
    },
    "views": {
      "codeToPlay": [
        {
          "id": "codeToPlayGames",
          "name": "Available Games",
          "icon": "media/icons/game-controller.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeToPlay.viewStats",
          "when": "view == codeToPlayGames",
          "group": "actions@1"
        },
        {
          "command": "codeToPlay.exportData",
          "when": "view == codeToPlayGames",
          "group": "actions@2"
        }
      ]
    },
    "commands": [
      {
        "command": "codeToPlay.playGame",
        "title": "Play Game",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.refreshGames",
        "title": "Refresh Games",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.showStatus",
        "title": "Show Game Status"
      },
      {
        "command": "codeToPlay.openSettings",
        "title": "Open Code to Play Settings",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.resetGame",
        "title": "Reset Game State",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.resetAllGames",
        "title": "Reset All Games",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.viewStats",
        "title": "View Stats",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.unlockAllGames",
        "title": "Unlock All Games",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.lockAllGames",
        "title": "Lock All Games",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.importData",
        "title": "Command to Import Data",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.exportData",
        "title": "Export Data",
        "category": "Code to Play"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "clean": "rimraf dist out",
    "rebuild": "pnpm run clean && pnpm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "chokidar": "^5.0.0",
    "concurrently": "^8.2.0",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.19.0",
    "eslint": "^9.32.0",
    "ovsx": "^0.8.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.2"
  }
}
