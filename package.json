{
  "name": "code-to-play",
  "displayName": "Code to Play",
  "description": "Play games in VS Code - earn playtime by writing code!",
  "version": "1.2.0",
  "publisher": "morse-code",
  "main": "./dist/extension.js",
  "author": {
    "name": "Victor Okenwa",
    "email": "okenwavictor003@gmail.com"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "media/icons/extension-icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Victor-Okenwa/code-to-play",
  "repository": {
    "type": "git",
    "url": "https://github.com/Victor-Okenwa/code-to-play"
  },
  "bugs": {
    "url": "https://github.com/Victor-Okenwa/code-to-play/issues"
  },
  "keywords": [
    "game",
    "games",
    "mini-games",
    "productivity",
    "break",
    "coding",
    "developer",
    "play",
    "siesta",
    "stress",
    "free",
    "unlock",
    "gamification",
    "fun",
    "code",
    "time",
    "leisure",
    "burnout",
    "focus",
    "motivation",
    "python",
    "typescript",
    "java",
    "kotlin",
    "c",
    "cpp",
    "c sharp",
    "programming languages"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeToPlay",
          "title": "Code to Play",
          "icon": "media/icons/game-controller.svg"
        }
      ]
    },
    "views": {
      "codeToPlay": [
        {
          "id": "codeToPlayGames",
          "name": "Available Games",
          "icon": "media/icons/game-controller.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeToPlay.viewStats",
          "when": "view == codeToPlayGames",
          "group": "actions@1"
        },
        {
          "command": "codeToPlay.exportData",
          "when": "view == codeToPlayGames",
          "group": "actions@2"
        },
        {
          "command": "codeToPlay.resetAllGames",
          "when": "view == codeToPlayGames",
          "group": "actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "codeToPlay.accountAction",
          "when": "false"
        },
        {
          "command": "codeToPlay.playsAction",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "codeToPlay.playGame",
        "title": "Play Game",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.refreshGames",
        "title": "Refresh Games",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.showStatus",
        "title": "Show Game Status"
      },
      {
        "command": "codeToPlay.openSettings",
        "title": "Open Code to Play Settings",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.resetGame",
        "title": "Reset Game State",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.resetAllGames",
        "title": "Reset highScores",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.viewStats",
        "title": "View Stats",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.exportData",
        "title": "Export Data",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.unlockAllGames",
        "title": "Unlock All Games",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.lockAllGames",
        "title": "Lock All Games",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.unlockPro",
        "title": "Unlock Pro",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.lockPro",
        "title": "Lock Pro (Free plan)",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.importData",
        "title": "Command to Import Data",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.ciBirdGrantGold",
        "title": "CI Bird: Grant Gold",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.ciBirdGrantDiamonds",
        "title": "CI Bird: Grant Diamonds",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.ciBirdUnlockCharacters",
        "title": "CI Bird: Unlock All Characters",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.debugSnakeGrantBugs",
        "title": "Debug Snake: Grant Bugs",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.debugSnakeGrantPink",
        "title": "Debug Snake: Grant Pink Balls",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.debugSnakeUnlockCharacters",
        "title": "Debug Snake: Unlock All Characters",
        "category": "Code to Play",
        "when": "codeToPlay:isDev"
      },
      {
        "command": "codeToPlay.signIn",
        "title": "Sign in with GitHub",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.signOut",
        "title": "Sign out",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.openDashboard",
        "title": "Open Dashboard",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.openPricing",
        "title": "Open Pricing",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.openSubscription",
        "title": "Open Subscription",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.accountAction",
        "title": "Account",
        "category": "Code to Play"
      },
      {
        "command": "codeToPlay.playsAction",
        "title": "Get more plays",
        "category": "Code to Play"
      }
    ],
    "configuration": {
      "title": "Code to Play",
      "properties": {
        "codeToPlay.sound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable all sound effects in games"
        },
        "codeToPlay.sound.volume": {
          "type": "number",
          "default": 1.0,
          "minimum": 0,
          "maximum": 1,
          "step": 0.1,
          "description": "Volume level for game sounds (0 to 1, where 1 is max)"
        },
        "codeToPlay.display.zoom": {
          "type": "number",
          "default": 0.85,
          "minimum": 0.5,
          "maximum": 1.5,
          "step": 0.05,
          "description": "Scale game UI in the webview panel (0.5 = 50%, 1.5 = 150%)"
        },
        "codeToPlay.display.allowFullscreen": {
          "type": "boolean",
          "default": true,
          "description": "Show the focus play button and allow the 80% gameplay overlay mode"
        },
        "codeToPlay.display.autoFullscreen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open focus play mode when a game is opened"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "clean": "rimraf dist out",
    "rebuild": "pnpm run clean && pnpm run compile",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "publish:both": "vsce publish && ovsx publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "chokidar": "^5.0.0",
    "concurrently": "^8.2.0",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.19.0",
    "eslint": "^9.32.0",
    "ovsx": "^0.8.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44"
  }
}